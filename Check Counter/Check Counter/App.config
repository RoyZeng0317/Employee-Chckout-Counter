<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <connectionStrings>
        <add name="CheckCounterDB" connectionString="Server=localhost;Port=3306;Database=checkout;User Id=root;Password=;" />
    </connectionStrings>
    <appSettings>
        <!-- NFC 讀卡機的 COM Port,例如 COM3;留空代表這台電腦沒有接讀卡機,NFC 功能不啟用 -->
        <add key="NfcComPort" value="" />
        <add key="NfcBaudRate" value="9600" />
    </appSettings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>